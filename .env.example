# Copie este archivo a .env y ajuste los valores. No contiene secretos reales.
APP_ENV=development

# --- Base de datos (PostgreSQL del docker-compose) ---
POSTGRES_DB=nutriruta
POSTGRES_USER=nutriruta
POSTGRES_PASSWORD=cambie_esta_clave_local
# La API y el worker arman DB_URL con los valores anteriores dentro de docker-compose.
# Para desarrollo sin Docker puede usar SQLite:
# DB_URL=sqlite:///./nutriruta.db

# --- Límites del MVP ---
MIN_CENTERS=5
MAX_CENTERS=50
MAX_GENERATIONS=1000
MAX_UPLOAD_MB=5
MAX_RUN_SECONDS=120

# --- Red ---
CORS_ORIGINS=http://localhost:8090
FRONTEND_PORT=8090
API_PORT=8010

# Opcional: commit de git para registrar la versión exacta del código en cada corrida.
GIT_COMMIT=

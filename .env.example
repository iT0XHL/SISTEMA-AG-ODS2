# Copie este archivo a .env y ajuste los valores. No contiene secretos reales.
# Use APP_ENV=production al desplegar. En ese modo la API no arranca si conserva las
# credenciales de demostración (ADMIN_PASSWORD, contraseña de la base) y la cookie de
# sesión se marca siempre como Secure (sirva la aplicación por HTTPS).
APP_ENV=development

# --- Base de datos (PostgreSQL del docker-compose) ---
POSTGRES_DB=nutriruta
POSTGRES_USER=nutriruta
POSTGRES_PASSWORD=cambie_esta_clave
# La API y el worker arman DB_URL con los valores anteriores dentro de docker-compose.
# Para desarrollo sin Docker puede usar SQLite:
# DB_URL=sqlite:///./nutriruta.db

# --- Límites del MVP ---
MIN_CENTERS=5
MAX_CENTERS=50
MAX_GENERATIONS=1000
MAX_UPLOAD_MB=5
MAX_RUN_SECONDS=120

# --- Red ---
CORS_ORIGINS=http://localhost:8090
FRONTEND_PORT=8090
API_PORT=8010

# --- Acceso ---
# La cuenta inicial se crea una sola vez, cuando la tabla de usuarios está vacía.
# Cambie la contraseña antes de compartir el sistema.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=NutriRuta2026!
ADMIN_NAME=Administrador
SESSION_HOURS=8
COOKIE_SECURE=false

# --- Rate limit (solicitudes por minuto y por cliente) ---
# Proxies de confianza delante de la API (0 = nginx con X-Real-IP; 2 = CloudFront + ALB en AWS).
TRUSTED_PROXY_HOPS=0
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MIN=1200
RATE_LIMIT_HEAVY_PER_MIN=30
RATE_LIMIT_LOGIN_PER_MIN=10

# Opcional: commit de git para registrar la versión exacta del código en cada corrida.
GIT_COMMIT=
